<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.clarimire.mapper.WarningRuleMapper">
    <select id="selectByIndicator" resultType="com.clarimire.entity.WarningRule">
        SELECT * FROM warning_rule WHERE indicator = #{indicator} AND enabled = 1 LIMIT 1
    </select>
</mapper>
